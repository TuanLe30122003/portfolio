# ── Server ────────────────────────────────────────────────
PORT=4000
# Comma-separated origins allowed by CORS
CORS_ORIGIN=http://localhost:3000

# ── Notion ────────────────────────────────────────────────
# Leave NOTION_TOKEN empty to serve built-in mock posts.
# Create an integration at https://www.notion.so/profile/integrations
NOTION_TOKEN=
# Database ID or the full database URL (share the database with the integration!)
NOTION_DATABASE_ID=
# Optional: set directly to skip the database → data source lookup
NOTION_DATA_SOURCE_ID=

# ── Cache ─────────────────────────────────────────────────
# Keep < 3000: Notion file URLs expire ~1h after being issued
CACHE_TTL_SECONDS=300
# Shared with frontend; protects POST /api/blog/revalidate
REVALIDATE_SECRET=dev-revalidate-secret
